{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "A3 Analytics Enterprise",
    "version": "2.5.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPData/**", "$DESKTOP/**", "$DOWNLOAD/**"]
      },
      "shell": {
        "all": true,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "Copyright 2026 A3 Analytics Inc.",
      "identifier": "com.a3analytics.enterprise",
      "icon": ["icons/icon.png"],
      "shortDescription": "Local-First AI Analytics Platform",
      "targets": ["msi", "nsis"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "A3 Analytics Enterprise - Local Privacy",
        "width": 1400
      }
    ]
  }
}
